---
import '../styles/global.css';
import { ajustes, asesores, principal, waLink } from '../lib/marca';
import WaIcon from '../components/WaIcon.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  hayEjemplos?: boolean;
}
const { title, description = ajustes.subtitulo, image, hayEjemplos = false } = Astro.props;
const fullTitle = title ? `${title} · ${ajustes.marca}` : `${ajustes.nombre_catalogo} · ${ajustes.marca}`;
const redes = asesores.flatMap((a) => [
  [`Instagram ${a.nombre.split(' ')[0]}`, a.instagram],
  [`TikTok ${a.nombre.split(' ')[0]}`, a.tiktok],
]).filter(([, u]) => u) as [string, string][];
// "Guillen & Vera" → Guillen <i>&</i> Vera
const [marcaA, marcaB] = ajustes.marca.split('&').map((s) => s.trim());
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700;800&family=Geist+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <div class="progress" aria-hidden="true"></div>
    {hayEjemplos && <div class="banner-demo">Algunas propiedades son de ejemplo y se reemplazarán por la cartera real.</div>}
    <nav class="top" id="nav"><div class="wrap">
      <a class="brand" href="/" style="color:inherit;text-decoration:none">{marcaB ? <>{marcaA} <i>&amp;</i> {marcaB}</> : marcaA}</a>
      <div class="navlinks">
        <a class="pillbtn hide-s" href="/#preguntas">Preguntas</a>
        <a class="pillbtn hide-s" href="/#propietarios">Vende con nosotros</a>
        <a class="pillbtn solid" href={waLink(principal.whatsapp)} target="_blank" rel="noopener"><WaIcon />WhatsApp</a>
      </div>
    </div></nav>

    <slot />

    <footer class="wrap">
      <span>{ajustes.marca} · Asesores inmobiliarios · Lima, Perú</span>
      <span style="display:flex;flex-wrap:wrap;gap:14px">
        {redes.map(([n, u]) => <a href={u} target="_blank" rel="noopener" style="color:inherit">{n}</a>)}
        <span>Precios referenciales en dólares</span>
      </span>
    </footer>

    <script>
      const nav = document.getElementById('nav');
      addEventListener('scroll', () => nav?.classList.toggle('scrolled', scrollY > 8), { passive: true });

      // contadores animados
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => es.forEach((en) => {
          if (!en.isIntersecting) return;
          io.unobserve(en.target);
          const b = en.target as HTMLElement, n = +(b.dataset.n ?? 0), t0 = performance.now();
          const tick = (t: number) => {
            const k = Math.min(1, (t - t0) / 1200);
            b.textContent = String(Math.round(n * (1 - Math.pow(1 - k, 3))));
            if (k < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }), { threshold: 0.6 });
        document.querySelectorAll('[data-n]').forEach((b) => io.observe(b));
      }

      // respaldo: si la web no se reconstruyó a tiempo, oculta las propiedades con exclusividad vencida
      const hoy = Date.now();
      document.querySelectorAll<HTMLElement>('[data-vence]').forEach((el) => {
        if (+el.dataset.vence! < hoy) {
          if (el.classList.contains('card')) el.remove();
          else el.hidden = false;
        }
      });
    </script>
  </body>
</html>
