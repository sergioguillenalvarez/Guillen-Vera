---
import Fotos from './Fotos.astro';
import { dinero, diasDesde, venceExclusividad, cerrada, esProyecto, precioBase, precioTexto, tipologiasDisponibles, enumerar, rango, enDolares, type Propiedad } from '../lib/propiedades';
interface Props { p: Propiedad }
const { p } = Astro.props;
const d = p.data;
const n = Math.max(1, Math.min(5, d.fotos.length || 5));
const vence = venceExclusividad(d);
const dias = diasDesde(d.fecha_publicacion);
const proyecto = esProyecto(d);
// Grupo para los filtros de la portada
const grupo = cerrada(d) ? 'Vendida' : d.operacion === 'Alquiler' ? 'Alquiler' : d.estado;
const tips = proyecto ? (tipologiasDisponibles(d).length ? tipologiasDisponibles(d) : d.tipologias) : [];
---
<a class="card reveal" href={`/propiedad/${p.id}/`} data-estado={grupo} data-dist={d.distrito} data-ref={d.codigo.replace('-', '').toUpperCase()} data-vence={vence && !cerrada(d) ? vence.getTime() + 86400000 : undefined} aria-label={`${d.titulo}, ${precioTexto(d)}`}>
  <div class="photos" style={`view-transition-name: foto-${p.id}`}>
    <div class="slides"><Fotos fotos={d.fotos} alt={d.titulo} /></div>
    {d.estado === 'Vendida' && <span class="tag sold"><span class="dot"></span>{d.dias_en_vender ? `Vendida en ${d.dias_en_vender} días` : 'Vendida'}</span>}
    {d.estado === 'Alquilada' && <span class="tag sold"><span class="dot"></span>Alquilada</span>}
    {d.estado === 'Oportunidad' && <span class="tag opp">Oportunidad{d.precio_anterior ? ` · −${Math.round((1 - precioBase(d) / d.precio_anterior) * 100)}%` : ''}</span>}
    {d.estado === 'Disponible' && <span class="tag"><span class="dot"></span>{proyecto ? `Proyecto · ${d.etapa === 'Entrega inmediata' ? 'Entrega inmediata' : d.entrega ?? d.etapa ?? 'en venta'}` : d.operacion === 'Alquiler' ? 'En alquiler' : dias <= 7 ? `Nueva · hace ${dias} día${dias === 1 ? '' : 's'}` : 'Disponible'}</span>}
    <span class="ref">{d.codigo}</span>
    {d.ejemplo && <span class="ejemplo">Ejemplo</span>}
    <button class="arrow l" type="button" aria-label="Foto anterior">‹</button><button class="arrow r" type="button" aria-label="Foto siguiente">›</button>
    <div class="dots">{Array.from({ length: n }, (_, i) => <i class={i ? '' : 'on'}></i>)}</div>
  </div>
  <div class="cinfo">
    <div class="cprice">
      {proyecto && <span class="desde">Desde</span>}{dinero(precioBase(d), d.moneda)}{d.operacion === 'Alquiler' && !proyecto && <span class="desde"> /mes</span>}
      {d.precio_anterior && <> <s style="font-size:18px;color:var(--muted)">{dinero(d.precio_anterior, d.moneda)}</s></>}
    </div>
    {proyecto
      ? <div class="cfacts"><b>{enumerar(tips.map((t) => t.dormitorios))}</b> dorm<span class="sep">|</span><b>{rango(tips.flatMap((t) => [t.area, t.area_max ?? t.area]))}</b> m²<span class="sep">|</span><b>{tips.length}</b> modelo{tips.length === 1 ? '' : 's'}</div>
      : <div class="cfacts">{d.dormitorios != null && <><b>{d.dormitorios}</b> dorm<span class="sep">|</span></>}{d.banos != null && <><b>{d.banos}</b> baños<span class="sep">|</span></>}{d.area_techada != null && <><b>{d.area_techada}</b> m²</>}{d.cocheras > 0 && <><span class="sep">|</span><b>{d.cocheras}</b> coch</>}</div>}
    {enDolares(precioBase(d), d) && <div class="caddr">{enDolares(precioBase(d), d)}</div>}
    <div class="caddr">{proyecto ? `Proyecto · ${d.distrito}` : `${d.tipo} · ${d.distrito}`}</div>
  </div>
</a>
