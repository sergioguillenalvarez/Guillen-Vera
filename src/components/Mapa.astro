---
// Mapa de Google con la zona aproximada. El punto ya viene desplazado 120–200 m de la
// dirección real (ver ubicacionAproximada), así el mapa orienta sin revelar la casa.
interface Props { lat: number; lng: number; distrito: string; referencia?: string | null }
const { lat, lng, distrito, referencia } = Astro.props;
const ll = `${lat.toFixed(5)},${lng.toFixed(5)}`;
const src = `https://maps.google.com/maps?q=${ll}&z=15&hl=es&output=embed`;
const abrir = `https://www.google.com/maps/search/?api=1&query=${ll}`;
// "A 3 cuadras de la estación…" se lee mejor como ", a 3 cuadras…" que como "cerca de A 3 cuadras…"
const ref = referencia?.trim();
const refTxt = !ref ? '' : /^(a|al|frente|junto|entre|cerca)\b/i.test(ref) ? `, ${ref.charAt(0).toLowerCase()}${ref.slice(1)}` : `, cerca de ${ref}`;
---
<div class="block">
  <h2 style="font-family:var(--display);font-size:34px">Ubicación</h2>
  <div class="mapa">
    <iframe src={src} title={`Zona aproximada en ${distrito}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
  </div>
  <p class="note">Zona aproximada en {distrito}{refTxt}. La dirección exacta se comparte al coordinar la visita.</p>
  <a class="pillbtn mapa-abrir" href={abrir} target="_blank" rel="noopener">Abrir en Google Maps</a>
</div>
