---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Fotos from '../../components/Fotos.astro';
import WaIcon from '../../components/WaIcon.astro';
import Tipologias from '../../components/Tipologias.astro';
import Mapa from '../../components/Mapa.astro';
import SolicitudVisita from '../../components/SolicitudVisita.astro';
import { asesores, waLink } from '../../lib/marca';
import {
  propiedadesPublicas, dinero, cuotaMensual, resolverTiktok, youtubeId, venceExclusividad, cerrada, esProyecto,
  precioBase, precioTexto, tipologiasDisponibles, enumerar, rango, ubicacionAproximada, enDolares, type Propiedad,
} from '../../lib/propiedades';

export async function getStaticPaths() {
  const props = await propiedadesPublicas();
  return props.map((p) => ({ params: { slug: p.id }, props: { p } }));
}

const { p } = Astro.props as { p: Propiedad };
const d = p.data;
const { Content } = await render(p);
const vendida = cerrada(d);
const proyecto = esProyecto(d);
const alquiler = d.operacion === 'Alquiler';
const precio = precioBase(d);
const tips = proyecto ? (tipologiasDisponibles(d).length ? tipologiasDisponibles(d) : d.tipologias) : [];
const tt = await resolverTiktok(d.tiktok);
const yt = youtubeId(d.recorrido_youtube);
const tieneRecorrido = Boolean(yt || d.recorrido_video);
const vence = venceExclusividad(d);
const punto = ubicacionAproximada(d.ubicacion, d.codigo);
const queEs = proyecto ? 'proyecto' : d.tipo.toLowerCase();
const msg = `Hola, vi en su página el ${queEs} ${d.codigo} en ${d.distrito} (${precioTexto(d)}) y quiero más información.`;
const portada = d.fotos[0];
const antiguedad = d.anio ? Math.max(0, new Date().getFullYear() - d.anio) : null;
const enumerarTexto = (xs: string[]) => (xs.length > 1 ? `${xs.slice(0, -1).join(', ')} o ${xs.at(-1)}` : xs[0]);
const estadoTexto = d.estado === 'Vendida' ? ` · Vendida${d.dias_en_vender ? ` en ${d.dias_en_vender} días` : ''}` : d.estado === 'Alquilada' ? ' · Alquilada' : d.estado === 'Oportunidad' ? ' · Oportunidad' : '';
---
<Base title={`${proyecto ? 'Proyecto' : d.tipo} en ${d.distrito} · ${precioTexto(d)}`} description={d.titulo} image={portada}>
  <div class="wrap">
    <div style="padding-top:16px"><a class="pillbtn" href="/">← Todas las propiedades</a></div>

    {vence && !vendida && (
      <div class="no-disp" data-vence={vence.getTime() + 86400000} hidden style="margin-top:16px">
        Esta propiedad ya no está en nuestra cartera. <a href="/">Mira las disponibles</a>.
      </div>
    )}

    <div class="mosaic" style={`view-transition-name: foto-${p.id}`}>
      <Fotos fotos={d.fotos} alt={d.titulo} tag="plain" />
    </div>

    <div class="dgrid">
      <div style="min-width:0">
        <div class="dhead">
          <div class="eyebrow">{d.codigo} · {proyecto ? 'Proyecto' : d.tipo} · {d.distrito}{alquiler ? ' · Alquiler' : ''}{estadoTexto}{d.ejemplo ? ' · Ejemplo' : ''}</div>
          <div class="dprice">{proyecto && <span class="desde" style="font-size:16px">Desde</span>}{dinero(precio, d.moneda)}{alquiler && <span class="desde" style="font-size:16px"> al mes</span>}</div>
          {enDolares(precio, d) && <div class="note" style="font-size:14px">{enDolares(precio, d)} · precio de lista</div>}
          {d.precio_anterior && <div class="note" style="font-size:14px">Antes {dinero(d.precio_anterior, d.moneda)} · ahorro de {dinero(d.precio_anterior - precio, d.moneda)}</div>}
          <h1 class="dtitle">{d.titulo}</h1>
          {proyecto
            ? <div class="kfacts">
                <div><b>{enumerar(tips.map((t) => t.dormitorios))}</b><span>dormitorios</span></div>
                <div><b>{rango(tips.flatMap((t) => [t.area, t.area_max ?? t.area]))} m²</b><span>áreas</span></div>
                <div><b>{tips.length}</b><span>modelos</span></div>
                {(d.etapa || d.entrega) && <div><b>{d.etapa === 'Entrega inmediata' ? 'Inmediata' : d.entrega || d.etapa}</b><span>entrega</span></div>}
              </div>
            : <div class="kfacts">
                {d.dormitorios != null && <div><b>{d.dormitorios}</b><span>dormitorios</span></div>}
                {d.banos != null && <div><b>{d.banos}</b><span>baños</span></div>}
                {d.area_techada != null && <div><b>{d.area_techada} m²</b><span>techados</span></div>}
                <div><b>{d.cocheras}</b><span>cocheras</span></div>
                {!alquiler && d.area_techada && <div><b>{dinero(Math.round(precio / d.area_techada), d.moneda)}</b><span>por m²</span></div>}
              </div>}
          <div class="desc"><Content /></div>
        </div>

        {proyecto && <Tipologias d={d} />}

        {!tt && !tieneRecorrido && d.tiktok && (
          <div class="block"><a class="pillbtn solid" style="justify-self:start" href={d.tiktok} target="_blank" rel="noopener">Ver el video en TikTok</a></div>
        )}
        {(tt || tieneRecorrido) && (
          <div class="block">
            <h2 style="font-family:var(--display);font-size:34px">Míralo en video</h2>
            {tt && tieneRecorrido && (
              <div class="tabs" id="vtabs" role="tablist">
                <button type="button" role="tab" aria-selected="true" data-t="tt">Video de TikTok</button>
                <button type="button" role="tab" aria-selected="false" data-t="tour">Recorrido completo</button>
              </div>
            )}
            {tt && (
              <div class="player vert panel-v" data-p="tt">
                <iframe src={`https://www.tiktok.com/player/v1/${tt}?description=0&music_info=0&rel=0`} title={`Video de TikTok de ${d.codigo}`} allow="fullscreen; encrypted-media; autoplay; picture-in-picture" loading="lazy"></iframe>
              </div>
            )}
            {tieneRecorrido && (
              <div class="player hor panel-v" data-p="tour" hidden={Boolean(tt)}>
                {yt
                  ? <iframe src={`https://www.youtube-nocookie.com/embed/${yt}?rel=0`} title={`Recorrido de ${d.codigo}`} allow="fullscreen; encrypted-media; picture-in-picture" loading="lazy"></iframe>
                  : <video src={d.recorrido_video!} controls playsinline preload="metadata"></video>}
              </div>
            )}
          </div>
        )}

        {!proyecto && <div class="block">
          <h2 style="font-family:var(--display);font-size:34px">Ficha técnica</h2>
          <div class="spec">
            {(d.area_techada ?? 0) > 0 && <div><span>Área techada</span><b>{d.area_techada} m²</b></div>}
            {(d.area_ocupada ?? 0) > 0 && <div><span>Área ocupada</span><b>{d.area_ocupada} m²</b></div>}
            {d.piso && <div><span>Piso</span><b>{d.piso}</b></div>}
            {d.ascensor && <div><span>Ascensor</span><b>{d.ascensor}</b></div>}
            {d.vista && <div><span>Vista</span><b>{d.vista}</b></div>}
            {antiguedad != null && <div><span>Antigüedad</span><b>{antiguedad === 0 ? 'Estreno' : `${antiguedad} año${antiguedad === 1 ? '' : 's'}`}</b></div>}
            {(d.mantenimiento ?? 0) > 0 && <div><span>Mantenimiento</span><b>S/ {d.mantenimiento} al mes</b></div>}
            <div><span>Cocheras</span><b>{d.cocheras || 'No tiene'}</b></div>
            {alquiler && d.amoblado != null && <div><span>Amoblado</span><b>{d.amoblado ? 'Sí' : 'No'}</b></div>}
            {alquiler && d.mascotas != null && <div><span>Mascotas</span><b>{d.mascotas ? 'Se aceptan' : 'No se aceptan'}</b></div>}
          </div>
        </div>}

        {alquiler
          ? <div class="block">
              <h2 style="font-family:var(--display);font-size:34px">Requisitos para alquilar</h2>
              <div class="legal">
                <div class="lrow"><span class="ic">1</span><p>{d.adelanto_meses ?? 1} mes de adelanto y {d.garantia_meses ?? 2} de garantía<span>La garantía se devuelve al terminar el contrato si el inmueble queda en buen estado.</span></p></div>
                <div class="lrow"><span class="ic">2</span><p>Sustento de ingresos<span>En planilla: tus últimas 3 boletas. Independiente: recibos por honorarios de los últimos 6 meses, estados de cuenta del mismo periodo y tu última declaración anual de renta en SUNAT.</span></p></div>
                <div class="lrow"><span class="ic">3</span><p>Buen historial crediticio<span>Revisamos tu reporte en centrales de riesgo antes de firmar.</span></p></div>
              </div>
            </div>
          : proyecto ? <div class="block">
              <h2 style="font-family:var(--display);font-size:34px">El proyecto</h2>
              <div class="legal">
                {(d.etapa || d.entrega) && <div class="lrow"><span class="ic">✓</span><p>{d.etapa === 'Entrega inmediata' ? 'Entrega inmediata' : `${d.etapa ?? 'Entrega'}${d.entrega ? ` · entrega ${d.entrega}` : ''}`}<span>{d.etapa === 'Entrega inmediata' ? 'Firmas y recibes tu departamento terminado.' : 'Te contamos el avance de obra y el cronograma de pagos.'}</span></p></div>}
                {d.estreno && <div class="lrow"><span class="ic">✓</span><p>Departamentos de estreno<span>Nadie los ha habitado antes.</span></p></div>}
                {d.sin_alcabala && <div class="lrow"><span class="ic">✓</span><p>No pagas alcabala<span>Es la primera venta, directa de la inmobiliaria.</span></p></div>}
                {d.bancos.length > 0
                  ? <div class="lrow"><span class="ic">✓</span><p>Crédito hipotecario con {enumerarTexto(d.bancos)}<span>{d.carta_fianza ? <>Es el banco aliado del proyecto. Con otro banco se pide carta fianza. <a href="/#faq-carta-fianza">¿Qué es?</a></> : 'Te ayudamos a precalificar.'}</span></p></div>
                  : <div class="lrow"><span class="ic">✓</span><p>{d.acepta_credito ? 'Acepta crédito hipotecario de cualquier banco' : 'Solo al contado'}<span>Te ayudamos a precalificar con el banco.</span></p></div>}
                {d.mantenimiento_nota && <div class="lrow"><span class="ic">i</span><p>Mantenimiento: {d.mantenimiento_nota}<span>Referencial, lo fija la junta de propietarios.</span></p></div>}
              </div>
              <p class="note">La dirección exacta se comparte al coordinar la visita.</p>
            </div>
          : <div class="block">
              <h2 style="font-family:var(--display);font-size:34px">Situación legal</h2>
              <div class="legal">
                <div class="lrow"><span class={`ic ${d.sunarp ? '' : 'w'}`}>{d.sunarp ? '✓' : '!'}</span><p>{d.sunarp ? 'Inscrita en SUNARP' : 'Inscripción en trámite'}<span>{d.sunarp ? 'Partida independizada a nombre del propietario.' : 'Te explicamos el estado del trámite.'}</span></p></div>
                <div class="lrow"><span class={`ic ${d.hipoteca_banco ? 'w' : ''}`}>{d.hipoteca_banco ? '!' : '✓'}</span><p>{d.hipoteca_banco ? `Tiene hipoteca con ${d.hipoteca_banco}` : 'Sin hipoteca ni cargas'}<span>{d.hipoteca_banco ? <>Se levanta con el pago de la compraventa. Es un trámite normal y lo coordinamos nosotros. <a href="/#faq-comprar-con-hipoteca">¿Cómo funciona?</a></> : 'No figuran gravámenes en la partida.'}</span></p></div>
                <div class="lrow"><span class="ic">✓</span><p>{d.acepta_credito ? 'Acepta crédito hipotecario' : 'Solo al contado'}<span>Te ayudamos a precalificar con el banco.</span></p></div>
              </div>
              <p class="note">La dirección exacta y los datos del propietario se comparten al coordinar la visita.</p>
            </div>}

        {punto && <Mapa lat={punto.lat} lng={punto.lng} distrito={d.distrito} referencia={d.referencia} />}
      </div>

      <aside class="cta">
        {vendida
          ? <><div class="eyebrow">{d.estado}</div><b style="font-size:18px">{d.estado === 'Alquilada' ? 'Esta propiedad ya se alquiló.' : d.dias_en_vender ? `Se vendió en ${d.dias_en_vender} días.` : 'Esta propiedad ya se vendió.'}</b><p class="note" style="font-size:14px">¿Tienes una propiedad parecida? Te contamos cómo la trabajaríamos.</p></>
          : <>
              <div class="eyebrow">¿Te interesa?</div>
              <b style="font-size:18px;line-height:1.3">Agenda tu visita en un minuto.</b>
              <button type="button" class="pillbtn solid vsend" data-abrir-visita>Solicitar visita</button>
              <small class="note">O escríbenos directo:</small>
            </>}
        <div class="agents">
          {asesores.map((a, i) => (
            <a class="agent" href={waLink(a.whatsapp, msg)} target="_blank" rel="noopener"><span class={`av ${i % 2 ? 'tv' : 'sg'}`}>{a.nombre[0]}</span><div><b>{a.nombre}</b><small>Responde por WhatsApp</small></div><span class="wa"><WaIcon /></span></a>
          ))}
        </div>
        {!vendida && !alquiler && d.acepta_credito && (
          <div class="calc"><small>Cuota mensual estimada{proyecto ? ' desde' : ''}</small><b>{dinero(cuotaMensual(precio), d.moneda)}</b><small>Con 20% de inicial, 20 años y TEA 8.5%. Referencial.</small></div>
        )}
        <p class="note">El mensaje ya incluye el código {d.codigo}, así sabemos qué propiedad viste.</p>
      </aside>
    </div>
  </div>
  {!vendida && <div class="mbar"><button type="button" class="pillbtn solid" data-abrir-visita>Solicitar visita</button></div>}
  {!vendida && <SolicitudVisita p={p} />}

  <script>
    document.getElementById('vtabs')?.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('button');
      if (!t) return;
      document.querySelectorAll('#vtabs button').forEach((b) => b.setAttribute('aria-selected', String(b === t)));
      document.querySelectorAll<HTMLElement>('.panel-v').forEach((p) => (p.hidden = p.dataset.p !== t.dataset.t));
    });
  </script>
</Base>
